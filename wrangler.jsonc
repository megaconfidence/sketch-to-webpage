{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sketch-to-webpage",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"ratelimits": [
		{
			"name": "GENERATION_LIMITER",
			"namespace_id": "927401",
			"simple": {
				"limit": 6,
				"period": 60
			}
		}
	],
	"vars": {
		"OCR_MODEL": "mistral-ocr-4-1",
		"GENERATION_MODEL": "mistral-large-4-0"
	},
	"secrets": {
		"required": [
			"MISTRAL_API_KEY"
		]
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true
}
